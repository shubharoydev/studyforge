DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studyforge
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_TOKEN_TTL=7d
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=30

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=studyforge-uploads

MAX_UPLOAD_MB=25
